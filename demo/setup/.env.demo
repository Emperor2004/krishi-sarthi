# Demo Environment Configuration
ENVIRONMENT=demo
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///./demo.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Security Configuration
JWT_SECRET_KEY=demo-jwt-secret-key-for-demonstration-only-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=6
LOGIN_RATE_LIMIT=10
LOGIN_WINDOW_MINUTES=300
API_RATE_LIMIT=200
API_WINDOW_SECONDS=60

# LLM Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=phi3:latest
OLLAMA_MODEL_CONVERSATION=phi3:latest
OLLAMA_MODEL_LISTING=phi3:latest
OLLAMA_MODEL_DISCOVERY=phi3:latest
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/demo.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=3

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
ALERTING_ENABLED=false
METRICS_RETENTION_HOURS=24
PERFORMANCE_PROFILING=true

# Application Configuration
HOST=0.0.0.0
PORT=8000

# Demo Specific Settings
DEMO_MODE=true
DEMO_DATA_SEED=true
DEMO_VOICE_SIMULATION=true
DEMO_AUTO_LOGIN=true

# CORS for Demo
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# SMS Fallback (Demo)
SMS_DEFAULT_VENDOR_ID=1
SMS_ENABLED=false

# Audio Processing (Demo)
AUDIO_ENABLED=true
WHISPER_MODEL=base
TTS_ENABLED=true
