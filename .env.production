# Production environment configuration
ENVIRONMENT=production
DEBUG=false

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/krishi_sarthi_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Security configuration
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-change-this-in-production-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8
LOGIN_RATE_LIMIT=5
LOGIN_WINDOW_MINUTES=300
API_RATE_LIMIT=100
API_WINDOW_SECONDS=60

# LLM configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:latest
OLLAMA_MODEL_CONVERSATION=phi3:latest
OLLAMA_MODEL_LISTING=phi3:latest
OLLAMA_MODEL_DISCOVERY=phi3:latest
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=300

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/krishi-sarthi/app.log
LOG_MAX_FILE_SIZE=10485760
LOG_BACKUP_COUNT=5

# Monitoring configuration
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
ALERTING_ENABLED=true
METRICS_RETENTION_HOURS=168
PERFORMANCE_PROFILING=false

# Email alerts configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=alerts@krishi-sarthi.com
ALERT_EMAIL_TO=admin@krishi-sarthi.com

# Application configuration
HOST=0.0.0.0
PORT=8000
